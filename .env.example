# --- Docker Compose Postgres (루트 .env에 복사 후 실제 값으로 변경) ---
POSTGRES_USER=DATABASE_USER
POSTGRES_PASSWORD=DATABASE_PASSWORD
POSTGRES_DB=DATABASE_NAME

# Nest 로컬 실행 시 DB 연결 문자열 (위 계정·DB명·포트에 맞출 것)
DATABASE_URL=postgresql://DATABASE_USER:DATABASE_PASSWORD@localhost:5432/DATABASE_NAME

# JWT 토큰 설정
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_SEC=900
JWT_REFRESH_EXPIRES_SEC=604800

# IdP 설정
IDP_URL=
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
